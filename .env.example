# Copy to .env and adjust. Every value has a safe default, so the app runs with no .env at all.

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Public address encoded in promo QR codes. Leave empty locally to auto-detect the LAN IP.
# On the playground set it to the deployed URL, e.g. https://your-app.onrender.com
PUBLIC_BASE_URL=

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Data source adapters (switching to a real feed = change one value)
# mock-aidx: AODB CSV snapshot + simulated AIDX XML feed | vendor-api: live stub
FLIGHT_SOURCE=mock-aidx
# mock-acris: NGSI-LD files | fiware-live: live stub
ZONE_SOURCE=mock-acris

# AI provider: mock (default, offline) | anthropic | openai-compatible
AI_PROVIDER=mock
# Only needed when AI_PROVIDER is not mock. Never commit real keys.
AI_API_KEY=
AI_MODEL=
